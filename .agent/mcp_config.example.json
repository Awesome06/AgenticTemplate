{
  "mcpServers": {
    "google-cloud": {
      "command": "npx",
      "args": [
        "-y",
        "@google-cloud/gcloud-mcp"
      ],
      "env": {
        "GOOGLE_APPLICATION_CREDENTIALS": "${workspaceFolder}/secrets/gcp-sa.json"
      }
    },
    "sqlite-cache": {
      "command": "uvx",
      "args": [
        "mcp-server-sqlite",
        "--db-path",
        "${workspaceFolder}/data/cache.db"
      ]
    }
  }
}
